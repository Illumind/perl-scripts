<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.NFC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-feature android:name="android.hardware.nfc" android:required="false" />

    <!-- Android 11+: щоб бачити, які гаманці/банки встановлені (налаштування джерел). -->
    <queries>
        <package android:name="com.samsung.android.spay" />
        <package android:name="com.samsung.android.samsungpay.gear" />
        <package android:name="com.google.android.apps.walletnfcrel" />
        <package android:name="com.ftband.mono" />
        <package android:name="ua.privatbank.ap24" />
        <package android:name="com.ideabank.izibank" />
        <package android:name="ua.com.abank" />
        <package android:name="ua.raiffeisen.myraif" />
        <package android:name="com.pumb.mobile" />
        <package android:name="ua.oschadbank.online" />
        <package android:name="com.sensebank.mobile" />
        <package android:name="ua.otpbank.android" />
        <package android:name="com.ukrsibbank.client.android" />
        <package android:name="ua.pravex.mobile" />
        <package android:name="com.revolut.revolut" />
        <package android:name="com.wise.android" />
        <package android:name="pl.pkobp.iko" />
        <package android:name="pl.mbank" />
        <package android:name="pl.ing.mojeing" />
        <package android:name="pl.bzwbk.bzwbk24" />
        <package android:name="eu.eleader.mobilebanking.pekao" />
        <package android:name="wit.android.bcpBankingApp.millenniumPL" />
    </queries>

    <application
        android:allowBackup="true"
        android:icon="@drawable/ic_launcher"
        android:roundIcon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.PurchaseTracker">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- NFC-мітка з записом purchase://add?amount=45.50&merchant=Кава відкриває додаток -->
            <intent-filter>
                <action android:name="android.nfc.action.NDEF_DISCOVERED" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="purchase" android:host="add" />
            </intent-filter>
        </activity>

        <service
            android:name=".PaymentNotificationListener"
            android:exported="true"
            android:label="@string/listener_name"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>
    </application>
</manifest>
